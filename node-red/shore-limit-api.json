      {
        "t": "eq",
        "v": "288",
        "vt": "num"
      }
    ],
    "checkall": "false",
    "repair": false,
    "outputs": 2,
    "x": 620,
    "y": 320,
    "wires": [
      [
        "out276"
      ],
      [
        "out288"
      ]
    ]
  },
