  {
    "id": "getfn",
    "type": "function",
    "z": "shore-limit-api",
    "name": "current limits",
    "func": "// Build the reply the dashboard reads back after a write.\nmsg.payload = {\n    \"276\": flow.get(\"lim276\"),\n    \"288\": flow.get(\"lim288\")\n};\nmsg.headers = { \"Access-Control-Allow-Origin\": \"*\", \"Cache-Control\": \"no-store\" };\nreturn msg;\n",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 400,
    "y": 240,
    "wires": [
      [
        "resp"
      ]
    ]
  },
  {
    "id": "postin",
    "type": "http in",
    "z": "shore-limit-api",
    "name": "",
    "url": "/shore-limit",
    "method": "post",
    "upload": false,
    "swaggerDoc": "",
    "x": 170,
    "y": 320,
    "wires": [
      [
        "postfn"
      ]
    ]
  },
  {
    "id": "postfn",
    "type": "function",
    "z": "shore-limit-api",
    "name": "validate + clamp",
    "func": "// Validate, clamp, and route on the vebus INSTANCE (not a unit number):\n//   276 = MultiPlus #1 on /dev/ttyS4\n//   288 = Multiplus #2 on /dev/ttyUSB0\n// The dashboard posts text/plain on purpose, so the browser sends no CORS\n// preflight; that keeps this working without touching settings.js.\nconst MAX = 50;\nconst cors = { \"Access-Control-Allow-Origin\": \"*\", \"Cache-Control\": \"no-store\" };\n\nlet b = msg.payload;\nif (typeof b === \"string\") {\n    try { b = JSON.parse(b); } catch (e) { b = {}; }\n}\n\nconst inst = Number(b.instance);\nlet limit = Number(b.limit);\n\nif ([276, 288].indexOf(inst) < 0 || !isFinite(limit)) {\n    const bad = Object.assign({}, msg, {\n        statusCode: 400,\n        headers: cors,\n        payload: { ok: false, error: \"need instance 276 or 288 and a numeric limit\" }\n    });\n    return [null, bad];\n}\n\nlimit = Math.max(0, Math.min(MAX, limit));\n\nconst write = { payload: limit, instance: inst };\nconst reply = Object.assign({}, msg, {\n    statusCode: 200,\n    headers: cors,\n    payload: { ok: true, instance: inst, limit: limit }\n});\nreturn [write, reply];\n",
    "outputs": 2,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 400,
    "y": 320,
    "wires": [
      [
        "route"
      ],
      [
        "resp"
      ]
    ]
  },
  {
    "id": "route",
    "type": "switch",
    "z": "shore-limit-api",
    "name": "by instance",
    "property": "instance",
    "propertyType": "msg",
